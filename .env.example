# --- Database ---
# A Postgres connection string. Free option: https://neon.tech (create a project, copy the "Pooled connection" string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
# Local dev: http://localhost:3000  |  Production: your deployed URL (e.g. https://yourapp.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (test mode) ---
# All from https://dashboard.stripe.com/test/apikeys and https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# The Price ID for your $9/mo Pro plan (recurring price), from https://dashboard.stripe.com/test/products
STRIPE_PRO_PRICE_ID="price_..."

# --- Email (OTP Verification) ---
# Option A: Resend (Recommended - https://resend.com)
RESEND_API_KEY="re_..."
RESEND_FROM="SnippetVault <onboarding@resend.dev>"

# Option B: SMTP (Gmail, Brevo, SendGrid, etc.)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="SnippetVault <your-email@gmail.com>"

